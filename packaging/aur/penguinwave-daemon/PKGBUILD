# Maintainer: Raul Ricea <raultynyo2001@gmail.com>
pkgname=penguinwave-daemon
pkgver=0.3.0
pkgrel=1
pkgdesc="Penguin Wave audio daemon and CLI: PipeWire sink management and headset ChatMix, no desktop required"
arch=('x86_64')
url="https://github.com/TempesTech/PenguinWave"
license=('Apache-2.0')
# No webview, GTK or tray dependency: this package must install and run on a
# headless machine.
depends=(
  'pipewire'
  'pipewire-pulse'
  'wireplumber'
  'hidapi'
)
makedepends=('rust' 'cargo')
optdepends=(
  'penguinwave: desktop interface'
  'polkit: install the udev rule from a client without editing it by hand'
)
install="$pkgname.install"
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/PenguinWave-$pkgver"
  cargo build --release --locked \
    -p penguinwave-daemon \
    -p penguinwave-cli
}

check() {
  cd "$srcdir/PenguinWave-$pkgver"
  # Live tests need a PipeWire session and a headset; they are ignored by
  # default and stay that way in a build chroot.
  cargo test --release --locked \
    -p penguinwave-proto \
    -p penguinwave-pipewire \
    -p penguinwave-hid \
    -p penguinwave-core \
    -p penguinwave-daemon \
    -p penguinwave-cli
}

package() {
  local src="$srcdir/PenguinWave-$pkgver"

  install -Dm755 "$src/target/release/penguinwave-daemon" \
    "$pkgdir/usr/bin/penguinwave-daemon"
  install -Dm755 "$src/target/release/penguinwave-cli" \
    "$pkgdir/usr/bin/penguinwave-cli"

  # A user unit: per-user, and never enabled by this package (see .install).
  install -Dm644 "$src/packaging/penguinwave.service" \
    "$pkgdir/usr/lib/systemd/user/penguinwave.service"

  install -Dm644 "$src/packaging/99-penguinwave.rules" \
    "$pkgdir/usr/lib/udev/rules.d/99-penguinwave.rules"

  # Generated by the binary itself, so they cannot drift from the commands.
  "$src/target/release/penguinwave-cli" completions bash \
    > "$srcdir/penguinwave-cli.bash"
  "$src/target/release/penguinwave-cli" completions zsh \
    > "$srcdir/_penguinwave-cli"
  "$src/target/release/penguinwave-cli" completions fish \
    > "$srcdir/penguinwave-cli.fish"

  install -Dm644 "$srcdir/penguinwave-cli.bash" \
    "$pkgdir/usr/share/bash-completion/completions/penguinwave-cli"
  install -Dm644 "$srcdir/_penguinwave-cli" \
    "$pkgdir/usr/share/zsh/site-functions/_penguinwave-cli"
  install -Dm644 "$srcdir/penguinwave-cli.fish" \
    "$pkgdir/usr/share/fish/vendor_completions.d/penguinwave-cli.fish"

  install -Dm644 "$src/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
