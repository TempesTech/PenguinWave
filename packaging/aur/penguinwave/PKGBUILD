# Maintainer: Raul Ricea <raultynyo2001@gmail.com>
pkgname=penguinwave
pkgver=0.3.0
pkgrel=1
pkgdesc="PipeWire virtual-sink manager and headset ChatMix control for Linux"
arch=('x86_64')
url="https://github.com/TempesTech/PenguinWave"
license=('Apache-2.0')
# The audio work all happens in the daemon now; this package is the window.
# hidapi is gone from here: nothing in the UI touches HID any more.
depends=(
  'penguinwave-daemon'
  'webkit2gtk-4.1'
  'gtk3'
  'libayatana-appindicator'
)
makedepends=(
  'rust'
  'cargo'
  'nodejs'
  'npm'
  'pkgconf'
)
optdepends=(
  'polkit: privileged udev-rule install from the in-app Maintenance page'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/PenguinWave-$pkgver/ui"
  npm ci
  npm run tauri:build -- --no-bundle
}

package() {
  local src="$srcdir/PenguinWave-$pkgver"

  # Path unchanged from 0.2.0: existing .desktop entries and launchers keep
  # working across the upgrade.
  install -Dm755 "$src/target/release/penguinwave" \
    "$pkgdir/usr/bin/penguinwave"

  install -Dm644 "$src/packaging/com.penguinwave.app.desktop" \
    "$pkgdir/usr/share/applications/com.penguinwave.app.desktop"

  # hicolor icon theme
  local size
  for size in 16 24 32 48 64 128 256 512; do
    install -Dm644 "$src/packaging/icons/penguinwave-$size.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/penguinwave.png"
  done
  install -Dm644 "$src/packaging/icons/penguinwave.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/penguinwave.svg"

  install -Dm644 "$src/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
